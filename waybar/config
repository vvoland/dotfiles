{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 0,

    // Left modules
    "modules-left": [
        "custom/launcher",
        "sway/workspaces",
        "sway/mode"
    ],
    "custom/launcher": {
        "format": "󰀻 ",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{index}"
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    // Right modules
    "modules-right": [
        "tray",
        "network",
        "cpu",
        "cpu#freq",
        "temperature",
        "memory",
        "backlight",
        "pulseaudio",
        "battery",
        "clock"
    ],
    "tray": {
        "icon-size": 24
    },
    "network": {
        "format": " Disabled",
        "format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-wifi": "{bandwidthDownBits:>} {bandwidthUpBits:>} ",
        "format-ethernet": "{bandwidthDownBits:>}{bandwidthUpBits:>}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "format-disconnected": "󰖪",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 5
    },
    "cpu": {
        "format": "{usage: >3}%",
        "on-click": "gnome-terminal -- fish -i -c htop"
    },
    "cpu#freq": {
        "format": " {min_frequency}/{max_frequency}GHz",
        "on-click": "gnome-terminal -- fish -i -c htop",
        "interval": 5
    },
    "temperature": {
        "critical-threshold": 80,
        "format-critical": " {temperatureC}°C",
        "format": " {temperatureC}°C",
        "tooltip-format": "{temperatureC}° Celsius\n{temperatureF}° Fahrenheit\n{temperatureK}° Kelvin"
    },
    "memory": {
        "format": "{: >3}%",
        "on-click": "gnome-terminal -- fish -i -c htop"
    },
    "backlight": {
        "format": "{icon} {percent: >3}%",
        "format-icons": ["", ""],
        "tooltip-format": "Backlight: {percent: >3}%"
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon}{volume: >3}%",
        "format-bluetooth": "󰂯 {icon} {volume: >3}%",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "on-click": "pavucontrol"
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip-format": "Power: {power} W",
        "format-critical": "󰀦 {icon}{capacity: >3}%",
        "format": "{icon}{capacity: >3}%",
        "format-icons": ["", "", "", "", "", ""]
    },
    "clock": {
        "interval": 1,
        "format": "  {:%H:%M:%S}",
        "tooltip-format": " {:%A %d/%m/%y}\n\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "on-scroll": 1,
            "format": {
                "months": "<span color='#efdac3'>{}</span>",
                "days": "<span color='#dcb6c9'>{}</span>",
                "weeks": "<span color='#89efcd'>W{}</span>",
                "weekdays": "<span color='#efbc56'>{}</span>",
                "today": "<span color='#ef5689'><u>{}</u></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
